        <mxCell id="1020" edge="1" parent="1" source="a7a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a7b" value="8. Request seat availability">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1021" edge="1" parent="1" source="a8a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a8b" value="9. Read seat allocations">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1022" edge="1" parent="1" source="a9a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a9b" value="10. Return available seats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1023" edge="1" parent="1" source="a10a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a10b" value="11. Display seat map">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1024" edge="1" parent="1" source="a11a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a11b" value="12. Enter passenger details and confirm">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1025" edge="1" parent="1" source="a12a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a12b" value="13. POST /bookings (idempotency key)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1026" edge="1" parent="1" source="a13a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a13b" value="14. Create pending booking + hold seats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1027" edge="1" parent="1" source="a14a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a14b" value="15. Booking ID and hold expiry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1028" edge="1" parent="1" source="a15a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a15b" value="16. Create payment order">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1029" edge="1" parent="1" source="a16a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a16b" value="17. Return payment URL / reference">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1030" edge="1" parent="1" source="a17a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a17b" value="18. Return payment redirect details">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1031" edge="1" parent="1" source="a18a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a18b" value="19. Redirect to payment gateway">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1032" edge="1" parent="1" source="a19a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a19b" value="20. Customer completes payment">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1033" edge="1" parent="1" source="a20a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a20b" value="21. Redirect to return page">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1034" edge="1" parent="1" source="a21a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a21b" value="22. Send signed payment webhook">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1035" edge="1" parent="1" source="a22a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a22b" value="23. Verify payment with provider">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1036" edge="1" parent="1" source="a23a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a23b" value="24. Payment verification result">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1037" edge="1" parent="1" source="a24a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeWidth=1.3;fontSize=11;labelBackgroundColor=#ffffff;" target="a24b" value="25. Mark payment successful; finalize seats">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="1038" edge="1" parent="1" source="a25a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=open;endFill=0;dashed=1;strokeWidth=1.2;fontSize=11;labelBackgroundColor=#ffffff;" target="a25b" value="26. Commit booking and seat status">
